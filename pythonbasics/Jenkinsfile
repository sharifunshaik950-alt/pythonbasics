pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Calculator build started'
            }
        }
        stage('Test') {
            steps {
                echo 'Running unit tests...'
            }
        }
        stage('Run Calculator') {
            steps {
                echo 'Executing application...'
            }
        }
        stage('Finish') {
            steps {
                echo 'Pipeline completed successfully!'
            }
        }
    }
}