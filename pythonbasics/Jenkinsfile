pipeline {
    agent any

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Clone Repo') {
            steps {
                echo 'Cloning repository...'
                // If using Git, replace URL with your repository URL:
                // git branch: 'main', url: 'https://github.com/your-username/your-repo.git'
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Executing unit tests...'
                // For Linux / macOS agents:
                sh 'python3 -m pytest test_addition.py'
                
                // For Windows agents, use 'bat' instead:
                // bat 'python -m pytest test_addition.py'
            }
        }

        stage('Run Scripts') {
            steps {
                echo 'Executing Python scripts...'
                sh 'python3 hello.py'
                sh 'python3 addition.py'
                sh 'python3 for.py'
                sh 'python3 reverse.py'
            }
        }

        stage('Cleanup') {
            steps {
                echo 'Pipeline completed successfully.'
            }
        }
    }
    
    post {
        always {
            echo 'Build finished.'
        }
        failure {
            echo 'Build failed. Check stage logs for details.'
        }
    }
}