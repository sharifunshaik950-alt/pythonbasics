pipeline {
    agent any

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Clone Repo') {
            steps {
                echo 'Cloning repository...'
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Installing pytest...'
                bat '"C:\\Users\\Shabana\\AppData\\Local\\Programs\\Python\\Python37\\python.exe" -m pip install pytest'

                echo 'Running tests...'
                bat '"C:\\Users\\Shabana\\AppData\\Local\\Programs\\Python\\Python37\\python.exe" -m pytest test_addition.py'
            }
        }

        stage('Run Scripts') {
            steps {
                echo 'Running hello.py...'
                bat '"C:\\Users\\Shabana\\AppData\\Local\\Programs\\Python\\Python37\\python.exe" hello.py'

                echo 'Running addition.py...'
                bat '"C:\\Users\\Shabana\\AppData\\Local\\Programs\\Python\\Python37\\python.exe" addition.py'
            }
        }

        stage('Cleanup') {
            steps {
                echo 'Cleaning up...'
            }
        }
    }
}